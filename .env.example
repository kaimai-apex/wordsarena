# Local development (Postgres + Redis via docker compose)
DATABASE_URL=postgresql://lexiform:lexiform@localhost:5432/lexiform
REDIS_URL=redis://localhost:6379
SESSION_SECRET=dev-secret-change-in-production-min-32-chars!!

# Optional: standalone API on :3001 (default uses Next.js /api routes)
API_URL=http://localhost:3001
REALTIME_URL=ws://localhost:3002
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3002

# Public site URL (set on Vercel to your production domain)
WEB_URL=http://localhost:3000

NODE_ENV=development

# --- Vercel (Project → Settings → Environment Variables) ---
# DATABASE_URL=postgresql://...   # Neon, Vercel Postgres, or Supabase
# SESSION_SECRET=...              # random 32+ char string
# WEB_URL=https://your-domain.vercel.app
