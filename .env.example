# =============================================================================
# WordsArena — environment variables
# Copy to .env for local dev: cp .env.example .env
# =============================================================================

# --- Database ---
# Local: docker compose -f infra/docker-compose.yml up -d
DATABASE_URL=postgresql://lexiform:lexiform@localhost:5432/lexiform

# Supabase Postgres — use Session or Transaction pooler (IPv4). Direct db.*.supabase.co is IPv6-only.
# Session pooler (port 5432): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543): same host, port 6543 — use on Vercel/serverless
# DATABASE_URL=postgresql://postgres.fpjlqvocnthwxeojoide:password@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# --- Auth (legacy cookie sessions — kept during Supabase migration) ---
SESSION_SECRET=dev-secret-change-in-production-min-32-chars!!

# --- Supabase Auth (Phase 1+; required for Google OAuth) ---
# Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server only — never expose to client

# --- WebSocket JWT (Phase 1+; short-lived tokens for apps/realtime) ---
# WS_JWT_SECRET=random-32-plus-char-string   # optional — defaults to SESSION_SECRET

# --- Redis (optional; local docker, Upstash in production) ---
REDIS_URL=redis://localhost:6379

# --- Service URLs (local dev) ---
API_URL=http://localhost:3001
REALTIME_URL=ws://localhost:3002
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3002

# Public site URL (set on Vercel to your production domain)
WEB_URL=http://localhost:3000

NODE_ENV=development

# =============================================================================
# Vercel (Project → Settings → Environment Variables)
# =============================================================================
# DATABASE_URL=postgresql://...              # Supabase Postgres connection string
# SESSION_SECRET=...                         # random 32+ char string
# WEB_URL=https://your-domain.vercel.app
# NEXT_PUBLIC_SUPABASE_URL=https://....supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...           # server only
# WS_JWT_SECRET=...                          # server only
# NEXT_PUBLIC_REALTIME_URL=wss://realtime.your-domain.fly.dev

# =============================================================================
# Supabase project setup (Phase 0 checklist)
# =============================================================================
# 1. Create project at https://supabase.com/dashboard
# 2. Authentication → Providers → enable Google (add OAuth client ID/secret)
# 3. Authentication → URL Configuration:
#    - Site URL: http://localhost:3000 (dev) / https://your-domain.vercel.app (prod)
#    - Redirect URLs: http://localhost:3000/auth/callback, https://your-domain.vercel.app/auth/callback
# 4. Project Settings → Database → copy connection string into DATABASE_URL
# 5. Project Settings → API → copy URL + anon key + service role key
# 6. Run: pnpm db:push   (applies Drizzle schema to Supabase Postgres)
# 7. Copy public + server vars to apps/web/.env.local (Next.js reads env from apps/web/)
